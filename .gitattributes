# Default: let Git decide text vs binary, normalize line endings to LF in the repo
* text=auto eol=lf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf

# Styles and markup
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Data / config
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.hcl text eol=lf
*.toml text eol=lf
*.webmanifest text eol=lf
*.conf text eol=lf
*.mermaid text eol=lf

# Docs
*.md text eol=lf

# Dotfiles / plain-text config
.gitignore text eol=lf
.dockerignore text eol=lf
.prettierignore text eol=lf
.nvmrc text eol=lf
.editorconfig text eol=lf

# Shell scripts and hooks
*.sh text eol=lf
.husky/* text eol=lf
Dockerfile text eol=lf

# Binaries - never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.cur binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.webp binary
*.mp3 binary
*.wav binary
